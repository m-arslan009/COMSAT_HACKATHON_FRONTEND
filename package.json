{
  "name": "comsat-hackathon-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:staged": "lint-staged --concurrent false",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.mjs\"",
    "audit": "npm audit --audit-level=low",
    "scan:secrets": "secretlint \"**/*\"",
    "verify": "npm ci --dry-run --ignore-scripts --no-audit && npm run scan:secrets && npm run format:check && npm run check && npm test && npm run audit && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "shadcn": {
      "ts-morph": {
        "@ts-morph/common": {
          "minimatch": "11.0.9"
        }
      }
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "secretlint": "^14.1.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
